# .env.local.example
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git (it's in .gitignore for security)
# This file shows the format of what .env.local should contain

NEXT_PUBLIC_SITE_URL=https://goldenlegacy.ae
NEXT_PUBLIC_FORM_ENABLED=true
NEXT_PUBLIC_RECIPIENT_EMAIL=your-business-email@goldenlegacy.ae

# Gmail SMTP Configuration
GMAIL_USER=your-actual-email@gmail.com
GMAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
