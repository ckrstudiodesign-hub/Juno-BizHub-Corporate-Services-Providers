{
  "version": 2,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "goldenlegacy.ae"
        }
      ],
      "destination": "https://www.goldenlegacy.ae/:path*",
      "permanent": true
    }
  ],
  "builds": [
    { "src": "next.config.js", "use": "@vercel/next" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|json|xml|svg|ico|webp|png|jpg|jpeg|gif)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    }
  ]
}