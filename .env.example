# ============================================
# Email Service Configuration (NEVER commit .env.local)
# ============================================

# Gmail SMTP Configuration
# Steps to set up:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer" (or your device)
# 4. Copy the generated 16-character password (remove spaces)
# 5. Paste below in .env.local (NOT in this file)

NEXT_PUBLIC_SITE_URL=https://www.goldenlegacy.ae
NEXT_PUBLIC_FORM_ENABLED=true

# Email recipient address (server-only; preferred)
RECIPIENT_EMAIL=inquiry@goldenlegacy.ae
# Optional legacy fallback (not recommended for new setups)
NEXT_PUBLIC_RECIPIENT_EMAIL=inquiry@goldenlegacy.ae

# Gmail credentials (KEEP IN .env.local ONLY - never commit)
GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-16-char-app-password
